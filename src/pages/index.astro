---
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../consts.js';

const title = `${SITE_NAME} — Free Construction & Landscaping Material Calculators`;
const description = 'Free, no-nonsense material calculators for concrete, gravel, and mulch. Enter your dimensions and get cubic yards, bags, tons, and a cost estimate in seconds — with a waste allowance built in.';

const cards = [
  {
    href: '/concrete-calculator',
    tag: 'Concrete',
    title: 'Concrete Calculator',
    desc: 'Cubic yards, 40/60/80 lb bag counts, and a cost estimate for slabs, footings, columns, tube forms, and steps.',
  },
  {
    href: '/gravel-calculator',
    tag: 'Gravel',
    title: 'Gravel Calculator',
    desc: 'Cubic yards, weight in tons, and cost for driveways, paver base, crushed stone, pea gravel, and sand.',
  },
  {
    href: '/mulch-calculator',
    tag: 'Mulch',
    title: 'Mulch Calculator',
    desc: 'Cubic yards, bag and pallet counts, and cost for flower beds and landscaping — with bulk-vs-bag guidance.',
  },
];

const faqItems = [
  {
    question: 'Are these calculators free?',
    answer: 'Yes. Every MaterialCalculator calculator is free to use, and there is no signup, trial period, or limit on the number of estimates you can run.',
  },
  {
    question: 'Do I need to create an account?',
    answer: 'No. The calculators run directly in your browser. Enter your project dimensions, adjust the assumptions if needed, and read the result without creating an account or saving personal details.',
  },
  {
    question: 'How accurate are the estimates?',
    answer: 'They are accurate planning estimates when the measurements and selected material are accurate. Actual use can change with uneven excavation, moisture, compaction, product yield, and installation technique, so confirm the final quantity with your supplier or contractor before ordering.',
  },
  {
    question: 'What is a waste allowance, and why include one?',
    answer: 'A waste allowance adds a small percentage above the exact geometric volume. Uneven ground, over-digging, spillage, compaction, and cuts all consume material. Five to ten percent is typical for a measured site; rough or irregular work may need more.',
  },
  {
    question: 'Which materials can I calculate?',
    answer: 'MaterialCalculator currently covers concrete, gravel, and mulch. These tools handle common project shapes and purchasing units, and more material calculators are planned as the site grows.',
  },
  {
    question: 'Are the results in US units?',
    answer: 'Yes. Inputs use feet and inches, and results use cubic feet, cubic yards, tons, and common US bag sizes. Where useful, a calculator may also show a metric volume for reference.',
  },
];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
});
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <p class="eyebrow">Materials takeoff, without the guesswork</p>
    <h1>Estimate exactly what your project needs.</h1>
    <p class="lede">{SITE_NAME} gives you fast, honest material estimates — cubic yards, bags, tons, and cost — with a waste allowance built in. Pick a calculator to get started.</p>
  </section>

  <section class="grid" aria-label="Calculators">
    {cards.map((c) => (
      <a class="card" href={c.href}>
        <span class="card-tag">{c.tag}</span>
        <span class="card-title">{c.title}</span>
        <span class="card-desc">{c.desc}</span>
        <span class="card-cta">Open calculator →</span>
      </a>
    ))}
  </section>

  <div class="prose home-content">
    <section aria-labelledby="what-you-can-estimate">
      <h2 id="what-you-can-estimate">What you can estimate</h2>

      <p>Use the <a href="/concrete-calculator">concrete calculator</a> for a slab, footing, round column, tube form, or set of poured steps. Enter the finished dimensions to get cubic yards and equivalent counts for common 40, 60, and 80 lb bags. It works for both small hand-mixed repairs and projects approaching ready-mix territory.</p>

      <p>The <a href="/gravel-calculator">gravel calculator</a> covers driveways, paths, drainage stone, paver base, crusher run, and pea gravel. Because suppliers quote aggregate by either cubic yard or ton, the result includes both. Choose the closest material, then enter the area and compacted depth to compare local quotes.</p>

      <p>For flower beds, tree rings, and landscaped areas, the <a href="/mulch-calculator">mulch calculator</a> converts bed area and depth into cubic yards, bags, and approximate pallets. It helps identify when a small bagged job becomes large enough for bulk delivery.</p>
    </section>

    <section aria-labelledby="how-estimates-work">
      <h2 id="how-estimates-work">How our estimates work</h2>

      <p>Every estimate begins with a standard engineering volume calculation. For a rectangular area, that is length × width × depth; circles, columns, triangles, footings, and steps use the matching geometric formula. Measurements are converted to consistent units first, then cubic feet are divided by 27 to produce cubic yards.</p>

      <p>Purchasing units use common industry figures: 27 cubic feet per cubic yard, about 0.6 cubic feet from a typical 80 lb concrete bag, roughly 1.4 tons of gravel per yard, and 2 cubic feet in a standard mulch bag. These are planning values, not universal constants. Aggregate weight changes with material and moisture, and bag yields vary by product, so each calculator explains important assumptions.</p>

      <p>Each calculator includes an adjustable waste allowance because low spots, over-excavation, spillage, compaction, and cuts increase real use; 5–10% is a normal starting range. Cost figures are reviewed periodically, but prices vary by place and season, so editable fields let you enter a local quote. Results are for planning—confirm the final order with your supplier.</p>
    </section>

    <section aria-labelledby="why-estimate-first">
      <h2 id="why-estimate-first">Why estimate before you buy</h2>

      <p>Estimating first can avoid a short-load fee on a small concrete delivery, a bulk pile you cannot return, or a second store trip halfway through the work. It also makes bags-versus-bulk comparisons meaningful: the lowest material price is not always cheapest after delivery, handling, and leftovers. A usable quantity lets you compare the complete purchase rather than guess from area alone.</p>
    </section>

    <section aria-labelledby="homepage-faq">
      <h2 id="homepage-faq">Frequently asked questions</h2>

      {faqItems.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>
  </div>
</Base>

<style>
  .hero { padding: 20px 0 6px; max-width: 60ch }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--hivis);
    margin: 0 0 8px;
  }
  .hero h1 { font-size: 34px; margin: 0 0 .3em }
  .hero .lede { font-size: 17px; color: var(--ink-2); margin: 0 }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 28px 0 8px;
  }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr } }

  .home-content {
    width: 100%;
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: 14px;
    padding: 18px 20px;
    text-decoration: none;
    box-shadow: 0 1px 0 rgba(20, 39, 63, .04), 0 12px 30px -20px rgba(20, 39, 63, .25);
    transition: border-color .15s ease, transform .15s ease;
  }
  .card:hover { border-color: var(--hivis); transform: translateY(-2px) }
  .card-tag {
    align-self: flex-start;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #fff;
    background: var(--hivis);
    border-radius: 5px;
    padding: 3px 8px;
    margin-bottom: 12px;
  }
  .card-title { font-size: 19px; font-weight: 700; color: var(--ink); letter-spacing: -.01em }
  .card-desc { font-size: 14px; color: var(--ink-2); margin-top: 6px; flex: 1 }
  .card-cta { font-size: 13.5px; font-weight: 700; color: var(--hivis); margin-top: 14px }
</style>
