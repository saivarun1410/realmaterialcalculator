---
import Base from '../layouts/Base.astro';
import { PRICES_REVIEWED } from '../consts.js';
import '../styles/concrete.css';

const title = 'Concrete Calculator — How Much Concrete Do I Need? (Bags & Yards)';
const description = 'Free concrete calculator: get cubic yards, bags (40/60/80 lb) and a cost estimate for slabs, footings, columns and steps, with a waste allowance built in.';

// FAQ structured data — mirrors the visible FAQ below, ported verbatim.
const jsonLd = `{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type":"Question","name":"How many 80 lb bags of concrete are in a cubic yard?","acceptedAnswer":{"@type":"Answer","text":"45 bags. An 80 lb bag yields about 0.6 cubic feet, and a cubic yard is 27 cubic feet, so 27 ÷ 0.6 = 45. It takes 60 sixty-pound bags or 90 forty-pound bags to fill the same cubic yard."}},
    {"@type":"Question","name":"How much concrete do I need for a 10x10 slab at 4 inches thick?","acceptedAnswer":{"@type":"Answer","text":"About 1.23 cubic yards (100 sq ft × 0.333 ft = 33.3 cubic feet ÷ 27). Add 10% for waste and order roughly 1.36 cubic yards. At this size, ready-mix is cheaper and faster than bags."}},
    {"@type":"Question","name":"Should I use bags or ready-mix concrete?","acceptedAnswer":{"@type":"Answer","text":"Under about 1 cubic yard (roughly 40–60 eighty-pound bags), bags are practical. Above that, ready-mix delivery is usually cheaper and far less labor, though loads under 1 cubic yard often carry a short-load fee."}},
    {"@type":"Question","name":"How thick should a concrete slab be?","acceptedAnswer":{"@type":"Answer","text":"4 inches is standard for patios, walkways and shed floors. Use 5–6 inches for driveways or anything carrying vehicle weight."}},
    {"@type":"Question","name":"How much extra concrete should I order for waste?","acceptedAnswer":{"@type":"Answer","text":"Add 5–10%. Spillage, an uneven subgrade, and slight over-digging all consume more concrete than the exact geometric volume. This calculator defaults to 10%."}}
  ]
}`;
---
<Base title={title} description={description} active="concrete" jsonLd={jsonLd}>
  <div class="crumb"><a href="/">Home</a> / <a href="/">Calculators</a> / Concrete</div>
  <h1>Concrete Calculator</h1>
  <p class="lede">Enter your dimensions and get the concrete you need in cubic yards, the exact bag count for 40, 60, and 80 lb bags, and a cost estimate — with a waste allowance built in. Works for slabs, footings, round columns, tube forms, and poured steps.</p>

  <!-- ================= CALCULATOR ================= -->
  <div class="calc">
    <div class="calc-grid">
      <div class="calc-in">
        <span class="worksheet-tag">Materials takeoff</span>
        <div class="shapes" id="shapes">
          <button class="shape on" data-shape="slab"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="8" width="18" height="9" rx="1"/></svg>Slab</button>
          <button class="shape" data-shape="footing"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="6" width="16" height="12" rx="1"/></svg>Footing</button>
          <button class="shape" data-shape="column"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="6" rx="7" ry="2.5"/><path d="M5 6v12a7 2.5 0 0 0 14 0V6"/></svg>Column / Tube</button>
          <button class="shape" data-shape="circular"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="12" rx="9" ry="4"/></svg>Circular slab</button>
          <button class="shape" data-shape="stairs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19h4v-4h4v-4h4V7h4"/></svg>Steps</button>
        </div>

        <div class="fields" id="fields"><!-- injected --></div>

        <div class="waste">
          <label>Waste allowance</label>
          <div class="seg" id="waste">
            <button data-w="0">0%</button>
            <button data-w="0.05">5%</button>
            <button data-w="0.10" class="on">10%</button>
            <button data-w="0.15">15%</button>
          </div>
        </div>
      </div>

      <div class="calc-out">
        <div class="result-lead">YOU NEED</div>
        <div class="big" id="cy">—</div>
        <div class="sub-vols" id="subvols">enter dimensions above</div>
        <div class="order-note" id="ordernote" style="display:none"></div>

        <div class="bags">
          <div class="bags-title">Pre-mix bags (incl. waste)</div>
          <div class="bagrow" data-bag="80"><span>80 lb bags</span><span class="n" id="b80">—</span></div>
          <div class="bagrow" data-bag="60"><span>60 lb bags</span><span class="n" id="b60">—</span></div>
          <div class="bagrow" data-bag="40"><span>40 lb bags</span><span class="n" id="b40">—</span></div>
        </div>

        <div class="cost">
          <div style="display:flex;justify-content:space-between"><span id="costlabel">Est. cost</span><span class="amt" id="costamt">—</span></div>
          <div class="costcfg">
            <div class="mini"><label>$ / cu yd (ready-mix)</label><div class="inp"><input id="pyd" type="number" value="135" min="0"></div></div>
            <div class="mini"><label>$ / 80 lb bag</label><div class="inp"><input id="pbag" type="number" value="6" min="0" step="0.5"></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Promotional CTA temporarily disabled.
  <div class="slot cta" id="cta" style="display:none">
    <div><div class="t" id="ctaT"></div><div class="s" id="ctaS"></div></div>
    <a href="/" id="ctaA" rel="nofollow sponsored">Get started</a>
  </div>
  -->

  <!-- in-content ad slot: highest-value placement, right after the tool -->
  <div class="slot"><span class="tag">◻ Ad slot — in-content (paste AdSense unit here)</span></div>

  <h2>How to measure for concrete</h2>
  <p>The calculator is only as accurate as your measurements, and concrete is unforgiving — you can't order "a bit more" once the truck leaves. Measure length and width in feet, and thickness in inches (most people get this wrong by mixing units). For a slab, thickness is the depth of the pour, not the depth of your excavation.</p>
  <p>Three things quietly inflate real-world volume beyond the clean geometric number:</p>
  <div class="note"><b>The over-dig problem.</b> If your subgrade isn't level, concrete fills every low spot. A slab formed at 4 inches can easily average 4.5–5 inches over an uneven base — that's 10–25% more concrete than the flat calculation. Compact and screed your base flat, or bump the waste allowance to 15%.</div>
  <p>For footings and columns, measure the actual form dimensions, not the hole. For round tube forms (Sonotube), the diameter printed on the tube is the finished diameter — use that. And if you're pouring several identical footings or columns, set the <b>quantity</b> field rather than adding them up by hand.</p>

  <h2>Worked example: a 10 × 12 ft patio</h2>
  <div class="example">
    <div class="step">Area: <b>10 ft × 12 ft = 120 sq ft</b></div>
    <div class="step">Thickness: <b>4 in = 0.333 ft</b></div>
    <div class="step">Volume: 120 × 0.333 = <b>40 cubic feet</b></div>
    <div class="step">Cubic yards: 40 ÷ 27 = <b>1.48 cu yd</b></div>
    <div class="step">+ 10% waste: <b>1.63 cu yd</b></div>
    <div class="tot">→ Order 1.75 cu yd of ready-mix (round up to the supplier's increment)</div>
  </div>
  <p>At 1.6+ cubic yards this is well past bag territory — it would take about 70 eighty-pound bags, over 5,000 lb of mix to haul, open, and mix by hand. Ordering ready-mix is cheaper and saves a brutal day of labor. Which brings up the decision most guides skip:</p>

  <h2>Bags vs. ready-mix: where the line actually is</h2>
  <p>The honest threshold is about <b>1 cubic yard</b>. Below it, bags win on convenience and there's no delivery minimum to worry about. Above it, ready-mix wins on both cost and effort — but watch for the <b>short-load fee</b>: most suppliers charge a premium on deliveries under 1 cubic yard, typically around $60–150, which can erase the savings on very small pours. So the awkward middle — roughly 0.7 to 1.5 cubic yards — is where you should price both.</p>
  <div class="note"><b>Rule of thumb:</b> under ~40 eighty-pound bags, buy bags. Over ~60, order ready-mix. In between, get a delivery quote including any short-load fee and compare.</div>

  <!-- affiliate slot in-context -->
  <div class="slot affiliate"><span class="tag">◻ Affiliate slot — "Compare concrete mix prices" (Home Depot / Lowe's / Amazon)</span></div>

  <h2>Concrete coverage chart</h2>
  <p>How much area one bag covers depends entirely on thickness. These figures use standard bag yields (80 lb ≈ 0.60 cu ft, 60 lb ≈ 0.45 cu ft, 40 lb ≈ 0.30 cu ft):</p>
  <table>
    <thead><tr><th>Bag size</th><th>Yield</th><th>Coverage @ 2″</th><th>Coverage @ 4″</th><th>Coverage @ 6″</th><th>Bags per cu yd</th></tr></thead>
    <tbody>
      <tr><td>80 lb</td><td class="mono">0.60 cu ft</td><td class="mono">3.6 sq ft</td><td class="mono">1.8 sq ft</td><td class="mono">1.2 sq ft</td><td class="mono">45</td></tr>
      <tr><td>60 lb</td><td class="mono">0.45 cu ft</td><td class="mono">2.7 sq ft</td><td class="mono">1.35 sq ft</td><td class="mono">0.9 sq ft</td><td class="mono">60</td></tr>
      <tr><td>40 lb</td><td class="mono">0.30 cu ft</td><td class="mono">1.8 sq ft</td><td class="mono">0.9 sq ft</td><td class="mono">0.6 sq ft</td><td class="mono">90</td></tr>
    </tbody>
  </table>
  <p>The last column is the fastest sanity check there is: it takes <b>45 eighty-pound bags to equal one cubic yard</b>. If your calculator result says 30+ bags, you're already at the point where ready-mix deserves a phone call.</p>

  <h2>What concrete costs</h2>
  <p>Two very different price structures, so estimate whichever route you're taking:</p>
  <p><b>Ready-mix</b> typically runs about <b>$125–165 per cubic yard</b> delivered in most of the US, based on average US supplier pricing, before add-ons. The add-ons are where budgets slip: short-load fees under 1 cu yd, an overtime/Saturday surcharge, and a waiting-time fee if your crew is slow to unload. <b>Bagged mix</b> is usually around <b>$5–8 per 80 lb bag</b>, so a cubic yard's worth of bags (45 of them) typically lands near $225–360 — often <i>more</i> than ready-mix per yard, which is the counterintuitive reason bags only make sense on small jobs.</p>
  <p class="note">Prices vary a lot by region and by month — the calculator's cost fields are editable, so drop in a real local quote for an accurate number.</p>
  <p class="disclaimer">Prices reviewed {PRICES_REVIEWED} — costs vary by region, supplier, and season.</p>

  <h2>Frequently asked questions</h2>
  <details><summary>How many 80 lb bags of concrete are in a cubic yard?</summary><p>45 bags. An 80 lb bag yields about 0.6 cubic feet, and a cubic yard is 27 cubic feet (27 ÷ 0.6 = 45). It takes 60 sixty-pound bags or 90 forty-pound bags to fill the same cubic yard.</p></details>
  <details><summary>How much concrete do I need for a 10×10 slab at 4 inches?</summary><p>About 1.23 cubic yards. That's 100 sq ft × 0.333 ft = 33.3 cubic feet, divided by 27. Add 10% for waste and order roughly 1.36 cubic yards. At this size ready-mix beats bags on both cost and labor.</p></details>
  <details><summary>Should I use bags or ready-mix?</summary><p>Under about 1 cubic yard (roughly 40–60 eighty-pound bags) bags are practical. Above that, ready-mix delivery is usually cheaper and far less work — just check for a short-load fee on deliveries under a cubic yard.</p></details>
  <details><summary>How thick should a concrete slab be?</summary><p>4 inches is standard for patios, walkways, and shed floors. Step up to 5–6 inches for driveways or anything that carries vehicle weight, and add rebar or wire mesh for those loads.</p></details>
  <details><summary>How much extra should I order for waste?</summary><p>Add 5–10%. Spillage, an uneven subgrade, and slight over-digging all consume more than the exact geometric volume. This calculator defaults to 10%; use 15% if your base isn't well compacted and screeded.</p></details>

  <h2>Related calculators</h2>
  <div class="related">
    <a href="/gravel-calculator"><div class="rt">Gravel Calculator →</div><div class="rd">Base rock and aggregate in tons or yards</div></a>
    <a href="/mulch-calculator"><div class="rt">Mulch Calculator →</div><div class="rd">Cubic yards and bags for beds and landscaping</div></a>
    <a href="/"><div class="rt">All calculators →</div><div class="rd">Browse every MaterialCalc estimator</div></a>
    <a href="/"><div class="rt">More coming soon →</div><div class="rd">Pavers, rebar and tube-form calculators are on the way</div></a>
  </div>

  <div class="byline">
    <span>Built by the MaterialCalc team · <span class="rev">Reviewed for accuracy</span></span>
    <span>Updated Jul 2026</span>
  </div>
  <p class="disclaimer">This calculator provides estimates for planning only. Bag yields and prices vary by manufacturer and region; always confirm order quantities with your concrete supplier and follow local building codes for structural work.</p>

  <aside slot="aside"><div class="sticky">
    <h4>◻ Ad slot — sidebar</h4>
    <div class="slot" style="min-height:250px;display:flex;align-items:center;justify-content:center"><span class="tag">300 × 250</span></div>
    <h4 style="margin-top:22px">Popular calculators</h4>
    <div class="related" style="grid-template-columns:1fr">
      <a href="/gravel-calculator"><div class="rt">Gravel →</div></a>
      <a href="/mulch-calculator"><div class="rt">Mulch →</div></a>
      <a href="/"><div class="rt">All calculators →</div></a>
    </div>
  </div></aside>

  <script is:inline>
(function(){
  "use strict";
  const TOFT = {ft:1, in:1/12, yd:3, m:3.28084, cm:1/30.48};
  const YIELD = {80:0.60, 60:0.45, 40:0.30};   // cubic feet per bag (standard)

  // field definitions per shape
  const SHAPES = {
    slab:     [["len","Length","ft"],["wid","Width","ft"],["thk","Thickness","in"],["qty","Quantity (slabs)","x"]],
    footing:  [["len","Length","ft"],["wid","Width","ft"],["dep","Depth","in"],["qty","Quantity (footings)","x"]],
    column:   [["dia","Diameter","in"],["hgt","Height","ft"],["qty","Quantity (columns)","x"]],
    circular: [["dia","Diameter","ft"],["thk","Thickness","in"]],
    stairs:   [["run","Run (per step)","in"],["rise","Rise (per step)","in"],["swid","Width","ft"],["steps","Number of steps","x"]]
  };
  const UNITSEL = ["in","ft","yd","cm","m"];
  const DEFAULTS = {len:10, wid:12, thk:4, dep:12, dia:12, hgt:9, qty:1, run:11, rise:7, swid:3, steps:3, circular_dia:8};

  let shape = "slab";
  let waste = 0.10;
  const $ = id => document.getElementById(id);

  function unitSelect(name, def){
    return '<select data-unit="'+name+'">'+UNITSEL.map(u=>'<option'+(u===def?' selected':'')+'>'+u+'</option>').join('')+'</select>';
  }

  function buildFields(){
    const defs = SHAPES[shape];
    $("fields").innerHTML = defs.map(([name,label,unit])=>{
      const isCount = unit==="x";
      let dval = DEFAULTS[name] ?? 1;
      if(shape==="circular" && name==="dia") dval = DEFAULTS.circular_dia;
      const cls = "field"+(isCount?" qty":"")+((defs.length%2 && defs.indexOf(defs.find(d=>d[0]===name))===defs.length-1 && !isCount)?"":"");
      return '<div class="field'+(isCount?' qty':'')+'">'+
        '<label>'+label+'</label>'+
        '<div class="inp"><input type="number" min="0" step="any" data-f="'+name+'" value="'+dval+'">'+
        (isCount?'':unitSelect(name,unit))+'</div></div>';
    }).join('');
    $("fields").querySelectorAll('input,select').forEach(el=>el.addEventListener('input',calc));
  }

  function ft(name){
    const inp = $("fields").querySelector('[data-f="'+name+'"]');
    if(!inp) return 0;
    const v = parseFloat(inp.value)||0;
    const sel = $("fields").querySelector('[data-unit="'+name+'"]');
    const u = sel ? sel.value : null;
    return u ? v*TOFT[u] : v;   // count fields have no unit
  }
  function count(name){ const inp=$("fields").querySelector('[data-f="'+name+'"]'); return Math.max(1, Math.round(parseFloat(inp&&inp.value)||1)); }

  function volumeCuFt(){
    if(shape==="slab")    return ft("len")*ft("wid")*ft("thk")*count("qty");
    if(shape==="footing") return ft("len")*ft("wid")*ft("dep")*count("qty");
    if(shape==="column"){ const r=ft("dia")/2; return Math.PI*r*r*ft("hgt")*count("qty"); }
    if(shape==="circular"){ const r=ft("dia")/2; return Math.PI*r*r*ft("thk"); }
    if(shape==="stairs"){ const n=count("steps"); return ft("swid")*ft("run")*ft("rise")*(n*(n+1)/2); }
    return 0;
  }

  function calc(){
    const raw = volumeCuFt();
    const cf = raw*(1+waste);
    if(!(cf>0)){
      $("cy").textContent="—"; $("subvols").textContent="enter dimensions above";
      ["b80","b60","b40"].forEach(id=>$(id).textContent="—");
      $("costamt").textContent="—"; $("ordernote").style.display="none";
      // Promotional CTA temporarily disabled: $("cta").style.display="none";
      return;
    }
    const cy = cf/27, cm = cf*0.0283168;
    $("cy").innerHTML = cy.toFixed(2)+' <small>cu yd</small>';
    $("subvols").textContent = cf.toFixed(1)+" cu ft  ·  "+cm.toFixed(2)+" m³  (incl. "+Math.round(waste*100)+"% waste)";

    const b80=Math.ceil(cf/YIELD[80]), b60=Math.ceil(cf/YIELD[60]), b40=Math.ceil(cf/YIELD[40]);
    $("b80").textContent=b80; $("b60").textContent=b60; $("b40").textContent=b40;

    const readymix = cy >= 1;   // threshold
    // recommendation highlight
    document.querySelectorAll('.bagrow').forEach(r=>r.classList.remove('rec'));
    if(!readymix) document.querySelector('.bagrow[data-bag="80"]').classList.add('rec');

    // order note
    const note=$("ordernote"); note.style.display="block";
    if(readymix) note.innerHTML="<b>Order ready-mix.</b> At "+cy.toFixed(2)+" cu yd (~"+b80+" bags) delivery is cheaper and far less labor — ask about any short-load fee under 1 yd.";
    else note.innerHTML="<b>Bags are fine here.</b> "+b80+" × 80 lb bags. Small enough that ready-mix delivery minimums aren't worth it.";

    // cost
    const pyd=parseFloat($("pyd").value)||0, pbag=parseFloat($("pbag").value)||0;
    if(readymix){ $("costlabel").textContent="Est. ready-mix cost"; $("costamt").textContent="$"+Math.round(cy*pyd).toLocaleString(); }
    else { $("costlabel").textContent="Est. bag cost (80 lb)"; $("costamt").textContent="$"+Math.round(b80*pbag).toLocaleString(); }

    /* Promotional CTA temporarily disabled.
    const cta=$("cta");
    cta.style.display="flex";
    if(readymix){
      cta.className="slot cta";
      $("ctaT").textContent="Pouring "+cy.toFixed(1)+" cu yd? Get local pro quotes.";
      $("ctaS").textContent="Compare concrete contractors near you — free, no obligation. [lead-gen link]";
      $("ctaA").textContent="Get free quotes";
    } else {
      cta.className="slot cta affiliate";
      $("ctaT").textContent="Need "+b80+" bags of concrete mix?";
      $("ctaS").textContent="Check current prices at Home Depot, Lowe's & Amazon. [affiliate link]";
      $("ctaA").textContent="Compare prices";
    }
    */
  }

  // shape tabs
  $("shapes").addEventListener("click",e=>{
    const b=e.target.closest(".shape"); if(!b) return;
    document.querySelectorAll(".shape").forEach(s=>s.classList.remove("on"));
    b.classList.add("on"); shape=b.dataset.shape; buildFields(); calc();
  });
  // waste
  $("waste").addEventListener("click",e=>{
    const b=e.target.closest("button"); if(!b) return;
    document.querySelectorAll("#waste button").forEach(x=>x.classList.remove("on"));
    b.classList.add("on"); waste=parseFloat(b.dataset.w); calc();
  });
  $("pyd").addEventListener("input",calc); $("pbag").addEventListener("input",calc);

  buildFields(); calc();
})();
  </script>
</Base>
